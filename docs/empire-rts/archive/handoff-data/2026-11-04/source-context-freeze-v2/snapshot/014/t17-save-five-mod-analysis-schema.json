{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:t17:five-mod-capture:analysis:design-fix-v2",
  "$comment": "Normative DESIGN schema. Source relations and LIMITS are equally required. All fields required unless explicit null union. Extra keys forbidden. No jsonschema dependency installation or source authority is implied. Name field semantics are normative NAME-PRODUCERS.json, with kind-specific raw versus decoded spelling. No new row fields or producer changes.",
  "allOf": [
    {
      "$ref": "#/$defs/finish"
    }
  ],
  "$defs": {
    "functionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "line",
        "endLine",
        "params",
        "start",
        "end"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        },
        "endLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        },
        "params": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8388608
          }
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        }
      }
    },
    "callRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callee",
        "args",
        "line",
        "context",
        "kind"
      ],
      "properties": {
        "callee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "args": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8388608
          }
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "kind": {
          "enum": [
            "CallExpression",
            "NewExpression"
          ]
        }
      }
    },
    "directWriterRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callee",
        "args",
        "line",
        "context",
        "kind",
        "literalName",
        "nameArgumentIndex",
        "target"
      ],
      "properties": {
        "callee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "args": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8388608
          }
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "kind": {
          "enum": [
            "RegisterGlobal",
            "RegisterComponentType",
            "RegisterSystemComponentType",
            "ReRegisterComponentType",
            "RegisterInterface",
            "RegisterMessageType",
            "SetGlobal",
            "SetProperty",
            "defineProperty",
            "defineProperties",
            "assign",
            "setPrototypeOf",
            "set",
            "deleteProperty",
            "eval",
            "Function",
            "LoadScript",
            "LoadGlobalScript",
            "LoadComponentScript",
            "LoadLibrary",
            "IncludeScript",
            "RunJobs"
          ]
        },
        "literalName": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 8388608
            },
            {
              "type": "null"
            }
          ]
        },
        "nameArgumentIndex": {
          "enum": [
            0,
            1
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8388608
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "aliasWriterRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callee",
        "args",
        "line",
        "context",
        "kind",
        "alias",
        "aliasSource",
        "aliasDeclarationLine",
        "literalName",
        "target"
      ],
      "properties": {
        "callee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "args": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8388608
          }
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "kind": {
          "enum": [
            "defineProperty",
            "defineProperties",
            "assign",
            "set",
            "deleteProperty"
          ]
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "aliasSource": {
          "enum": [
            "Object.defineProperty",
            "Object.defineProperties",
            "Object.assign",
            "Object.set",
            "Object.deleteProperty",
            "Reflect.defineProperty",
            "Reflect.defineProperties",
            "Reflect.assign",
            "Reflect.set",
            "Reflect.deleteProperty"
          ]
        },
        "aliasDeclarationLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        },
        "literalName": {
          "const": null
        },
        "target": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8388608
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "aliasRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "line",
        "context"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8388608
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        }
      }
