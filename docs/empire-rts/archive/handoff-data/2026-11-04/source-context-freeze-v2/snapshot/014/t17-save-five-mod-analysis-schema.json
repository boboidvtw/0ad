      "properties": {
        "kind": {
          "enum": [
            "=",
            "+=",
            "-=",
            "*=",
            "/=",
            "%=",
            "**=",
            "<<=",
            ">>=",
            ">>>=",
            "|=",
            "^=",
            "&=",
            "||=",
            "&&=",
            "??="
          ]
        },
        "left": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "right": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        }
      }
    },
    "updateRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "left",
        "line",
        "context"
      ],
      "properties": {
        "kind": {
          "enum": [
            "++",
            "--"
          ]
        },
        "left": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        }
      }
    },
    "deleteRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "left",
        "line",
        "context"
      ],
      "properties": {
        "kind": {
          "const": "delete"
        },
        "left": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        }
      }
    },
    "topLevelRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "line"
      ],
      "properties": {
        "kind": {
          "enum": [
            "variable",
            "function"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388609
        }
      }
    },
    "parsed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vfs",
        "parseStatus",
        "mode",
        "functions",
        "calls",
        "writerSites",
        "aliases",
        "assignments",
        "fileTopLevelDeclarations",
        "closure"
      ],
      "properties": {
        "vfs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "parseStatus": {
          "const": "PARSED"
        },
        "mode": {
          "enum": [
            "script",
            "module"
          ]
        },
        "functions": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/functionRow"
          }
        },
        "calls": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/callRow"
          }
        },
        "writerSites": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/directWriterRow"
              },
              {
                "$ref": "#/$defs/aliasWriterRow"
              }
            ]
          }
        },
        "aliases": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/aliasRow"
          }
        },
        "assignments": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/assignmentRow"
              },
              {
                "$ref": "#/$defs/updateRow"
              },
              {
                "$ref": "#/$defs/deleteRow"
              }
            ]
          }
        },
        "fileTopLevelDeclarations": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/topLevelRow"
          }
        },
        "closure": {
          "const": "OPEN_REQUIRES_POSITIVE_SEMANTIC_CALLER_PROOF"
        }
      }
    },
    "parseError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vfs",
        "parseStatus",
        "error",
        "closure"
      ],
      "properties": {
        "vfs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "parseStatus": {
          "const": "BLOCK_PARSE_ERROR"
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "closure": {
          "const": "OPEN_PARSE_ERROR"
        }
      }
    },
    "utf8Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vfs",
        "parseStatus",
        "closure"
      ],
      "properties": {
        "vfs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        },
        "parseStatus": {
          "const": "BLOCK_UTF8_ERROR"
        },
        "closure": {
          "const": "OPEN_INVALID_SOURCE_ENCODING"
        }
      }
    },
    "analysis": {
      "oneOf": [
        {
          "$ref": "#/$defs/parsed"
        },
        {
          "$ref": "#/$defs/parseError"
        },
        {
          "$ref": "#/$defs/utf8Error"
        },
        {
          "type": "null"
        }
      ]
    },
    "analysisEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "sha256",
        "analysis"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "analysis": {
          "$ref": "#/$defs/analysis"
        }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "captureId",
        "analyses",
        "tool"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "const": "FINISH"
        },
        "captureId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "analyses": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/analysisEnvelope"
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeVersion",
            "acornVersion",
            "nodeSourceSHA256"
          ],
          "properties": {
            "nodeVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "acornVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "nodeSourceSHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
