+def shallow_ascii_json(raw):
+    """Bound depth before JSON object allocation, ignoring quoted punctuation."""
+    require(type(raw) is bytes and len(raw) <= 2097152, 'HISTORY_ENCODED_BOUND')
+    raw.decode('ascii', 'strict')
+    depth, quoted, escaped, entry_commas = 0, False, False, 0
+    for value in raw:
+        if quoted:
+            if escaped:
+                escaped = False
+            elif value == 92:
+                escaped = True
+            elif value == 34:
+                quoted = False
+        elif value == 34:
+            quoted = True
+        elif value == 44 and depth == 2:
+            entry_commas += 1
+            require(entry_commas < 64, 'HISTORY_PREPARSE_ENTRY_BOUND')
+        elif value in (123, 91):
+            depth += 1
+            require(depth <= 3, 'HISTORY_JSON_DEPTH')  # primitives are level4.
+        elif value in (125, 93):
+            depth -= 1
+            require(depth >= 0, 'HISTORY_JSON_DEPTH')
+    require(depth == 0 and not quoted, 'HISTORY_JSON_DEPTH')
+    return strict(raw)
