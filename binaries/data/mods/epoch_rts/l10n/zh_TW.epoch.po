msgid "Frontier Union"
msgstr "拓荒聯盟"

msgid "Frontier Worker"
msgstr "拓荒工人"

msgid "Pioneer"
msgstr "拓荒工人"

msgid "Spearman"
msgstr "長矛兵"

msgid "Slinger"
msgstr "投石兵"

msgid "Iron Swordsman"
msgstr "鐵刃步兵"

msgid "Civic Center"
msgstr "市中心"

msgid "House"
msgstr "房屋"

msgid "Storehouse"
msgstr "倉庫"

msgid "Barracks"
msgstr "兵營"

msgid "Field"
msgstr "農田"

msgid "Forge"
msgstr "鍛造所"

msgid "Bronze Age"
msgstr "青銅時代"

msgid "Iron Age"
msgstr "鐵器時代"

msgid "Forged Weapons"
msgstr "鍛造兵器"

msgid "Forged Weapons completed"
msgstr "鍛造兵器已完成"

msgid "Researching: %(percent)s%%"
msgstr "研究中：%(percent)s%%"

msgid "Research queued"
msgstr "研究排隊中"

msgid "Build a Forge to research weapons"
msgstr "建造鍛造所以研究兵器"

msgid "Requires a completed Barracks"
msgstr "需要已完工兵營"

msgid "Insufficient resources for research"
msgstr "研究資源不足"

msgid "Forged Weapons available"
msgstr "可研究鍛造兵器"

msgid "Iron Age research available"
msgstr "可研究鐵器時代"

msgid "Requires Iron Age."
msgstr "需要鐵器時代。"

msgid "Requires a completed Barracks and Bronze Age."
msgstr "需要青銅時代與一棟已完工兵營。"

msgid "Advance to Iron Age. Unlock Iron Swordsmen and the Forge."
msgstr "進入鐵器時代，解鎖鐵刃步兵與鍛造所。"

msgid "Unlock Iron Swordsmen and the Forge."
msgstr "解鎖鐵刃步兵與鍛造所。"

msgid "Improve the weapons of Spearmen and Iron Swordsmen."
msgstr "改良長矛兵與鐵刃步兵的兵器。"

msgid "Spearmen and Iron Swordsmen gain +2 hack damage. Applies to existing and future units."
msgstr "長矛兵與鐵刃步兵的劈砍傷害增加 2，現有與未來單位皆有效。"

msgid "Iron Age research cancelled: a completed Barracks is required. Resources refunded."
msgstr "鐵器時代研究已取消：需要已完工兵營，資源已退還。"

msgid "Cannot build: select a suitable worker and meet the age requirements."
msgstr "無法建造：請選擇合適工人並滿足時代條件。"

msgid "Units occupy the building site. Move them away first."
msgstr "建造位置有單位佔用，請先移開。"

msgid "Frontier Worker: Gather resources, construct and repair buildings."
msgstr "拓荒工人：採集資源、建造及維修建築。"

msgid "Spearman: Combat unit. Cannot gather or build."
msgstr "長矛兵：戰鬥單位，不能採集或建造。"

msgid "Slinger: Combat unit. Cannot gather or build."
msgstr "投石兵：遠程戰鬥單位，不能採集或建造。"

msgid "Iron Swordsman: Combat unit. Cannot gather or build."
msgstr "鐵刃步兵：鐵器時代步兵，不能採集或建造。"

msgid "Goal: destroy every enemy unit and building. The AI attacks after it reaches Iron Age."
msgstr "目標：消滅敵方所有單位與建築。敵方 AI 進入鐵器時代後才會進攻。"

msgid "1. Select Pioneers and right-click trees, berries, stone or metal to gather."
msgstr "1. 選取拓荒工人，右鍵點樹木、莓果叢、石礦或金屬礦開始採集。"

msgid "2. Population starts at 20. Each House adds 10 (50 wood). Keep building Houses."
msgstr "2. 人口上限一開始是 20，每棟房屋 +10（木材 50）。記得持續蓋房屋。"

msgid "3. Build a Barracks (150 wood, 50 stone) to train Spearmen and Slingers."
msgstr "3. 蓋兵營（木材 150、石材 50）訓練長矛兵與投石兵。"

msgid "4. With a completed Barracks, research Iron Age at the Civic Center (400 food, 200 wood, 100 metal)."
msgstr "4. 兵營完工後，在市中心研究鐵器時代（食物 400、木材 200、金屬 100）。"

msgid "5. Iron Age unlocks Iron Swordsmen and the Forge. Research Forged Weapons at the Forge."
msgstr "5. 鐵器時代解鎖鐵刃步兵與鍛造所，可在鍛造所研究鍛造兵器。"

msgid "Press Ctrl+P to hide or show this guide."
msgstr "按 Ctrl+P 隱藏或顯示這份說明。"

msgid "Dark Age"
msgstr "黑暗時代"

msgid "Middle Ages"
msgstr "中世紀"

msgid "Renaissance"
msgstr "文藝復興"

msgid "Stable"
msgstr "馬廄"

msgid "Siege Workshop"
msgstr "攻城工坊"

msgid "Horseman"
msgstr "騎兵"

msgid "Knight"
msgstr "騎士"

msgid "Battering Ram"
msgstr "攻城槌"

msgid "Bombard"
msgstr "射石砲"

msgid "Requires Dark Age."
msgstr "需要黑暗時代。"

msgid "Requires Middle Ages."
msgstr "需要中世紀。"

msgid "Requires Renaissance."
msgstr "需要文藝復興。"

msgid "Requires a completed Forge"
msgstr "需要已完工鍛造所"

msgid "Requires a completed Stable"
msgstr "需要已完工馬廄"

msgid "Requires a completed Siege Workshop"
msgstr "需要已完工攻城工坊"

msgid "Dark Age research available"
msgstr "可研究黑暗時代"

msgid "Middle Ages research available"
msgstr "可研究中世紀"

msgid "Renaissance research available"
msgstr "可研究文藝復興"

msgid "All ages reached"
msgstr "已達最終時代"

msgid "Unlock the Stable and Horsemen."
msgstr "解鎖馬廄與騎兵。"

msgid "Requires a completed Forge and Iron Age."
msgstr "需要鐵器時代與一棟已完工鍛造所。"

msgid "Advance to Dark Age. Unlock the Stable and Horsemen."
msgstr "進入黑暗時代，解鎖馬廄與騎兵。"

msgid "Unlock the Siege Workshop, Battering Rams and Knights."
msgstr "解鎖攻城工坊、攻城槌與騎士。"

msgid "Requires a completed Stable and Dark Age."
msgstr "需要黑暗時代與一棟已完工馬廄。"

msgid "Advance to Middle Ages. Unlock the Siege Workshop, Battering Rams and Knights."
msgstr "進入中世紀，解鎖攻城工坊、攻城槌與騎士。"

msgid "Unlock Bombards at the Siege Workshop."
msgstr "解鎖攻城工坊的射石砲。"

msgid "Requires a completed Siege Workshop and Middle Ages."
msgstr "需要中世紀與一棟已完工攻城工坊。"

msgid "Advance to Renaissance. Unlock Bombards at the Siege Workshop."
msgstr "進入文藝復興，解鎖攻城工坊的射石砲。"

msgid "Dark Age research cancelled: a completed Forge is required. Resources refunded."
msgstr "黑暗時代研究已取消：需要已完工鍛造所，資源已退還。"

msgid "Middle Ages research cancelled: a completed Stable is required. Resources refunded."
msgstr "中世紀研究已取消：需要已完工馬廄，資源已退還。"

msgid "Renaissance research cancelled: a completed Siege Workshop is required. Resources refunded."
msgstr "文藝復興研究已取消：需要已完工攻城工坊，資源已退還。"

msgid "Horseman: Fast mounted combat unit. Cannot gather or build."
msgstr "騎兵：快速的騎乘戰鬥單位，不能採集或建造。"

msgid "Knight: Heavily armored cavalry. Cannot gather or build."
msgstr "騎士：重裝騎兵，不能採集或建造。"

msgid "Battering Ram: Siege unit. Attacks buildings only."
msgstr "攻城槌：攻城單位，只能攻擊建築。"

msgid "Bombard: Long-range siege unit. Must unpack before firing."
msgstr "射石砲：遠程攻城單位，開火前要先展開。"

msgid "6. Keep advancing at the Civic Center: Dark Age needs a Forge, Middle Ages a Stable, Renaissance a Siege Workshop. Each age costs more."
msgstr "6. 繼續在市中心升級時代：黑暗時代需要鍛造所，中世紀需要馬廄，文藝復興需要攻城工坊，每個時代都比前一個貴。"
